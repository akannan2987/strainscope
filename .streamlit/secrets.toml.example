# .streamlit/secrets.toml.example: what the ONLINE copy's "Secrets" box holds.
#
# On Streamlit Community Cloud: open the app's Settings, then Secrets, and paste
# these lines with your own values (docs/08-deployment-ai.md, sections 9 and 10).
# Streamlit puts every top-level line into the app's environment when it starts,
# so StrainScope reads them exactly like the lines of a .env file.
#
# NEVER put a real key in THIS file: it is committed as a template. A real
# .streamlit/secrets.toml (for trying the online setup on your own computer)
# is ignored by Git and refused by ./check-public-safe.sh.

# Shared mode: hides the real-data buttons, builds the database on the first
# start, and caps the AI features' requests per day.
STRAINSCOPE_MODE = "public"

# Optional: written answers and model-written queries with a hosted model
# (any provider with an OpenAI-compatible interface). Leave these four out,
# and the AI features answer by search and rules alone, sending nothing.
# STRAINSCOPE_ASK_BACKEND = "hosted"
# STRAINSCOPE_ASK_URL = "https://the-address-your-provider-gives/v1"
# STRAINSCOPE_ASK_MODEL = "the-model-name"
# STRAINSCOPE_ASK_KEY = "your-key"

# Optional: requests to the model per day for the whole copy (default 200 in
# shared mode; 0 means none at all).
# STRAINSCOPE_AI_DAILY_LIMIT = "200"
