# StrainScope: optional secrets, one KEY=VALUE per line.
# Copy this file to `.env` (which Git ignores) and fill in real values there.
# NEVER put a real key in THIS file. .env.example is committed as a template.

# Optional: a free NCBI API key raises the Datasets rate limit from 5 to 10
# requests/second. Get one at https://www.ncbi.nlm.nih.gov/account/ (Account
# settings -> API Key Management). Leave unset and everything still works.
NCBI_API_KEY=

# Optional: written answers in Ask StrainScope (docs/07b-docs-assistant.md
# sections 8 and 9). Leave STRAINSCOPE_ASK_BACKEND unset (or "none") and Ask
# StrainScope searches only, sending nothing anywhere.
#   local  = a model on this computer, served by Ollama (no key needed)
#   hosted = a provider with an OpenAI-compatible interface (needs the key)
STRAINSCOPE_ASK_BACKEND=
# local: defaults to llama3.2:3b and http://localhost:11434/v1; hosted: required
STRAINSCOPE_ASK_MODEL=
STRAINSCOPE_ASK_URL=
# hosted only. A real key goes in .env, NEVER in this file.
STRAINSCOPE_ASK_KEY=

# Optional (Phase 7, docs/08-deployment-ai.md): "public" runs the app as a
# shared copy, the way the online copy runs (real-data buttons hidden, the
# database built on the first start, a daily cap on model requests).
STRAINSCOPE_MODE=
# Optional (Phase 7): model requests per day for this copy. Unset: 200 in
# shared mode, no cap otherwise. 0 means none at all.
STRAINSCOPE_AI_DAILY_LIMIT=
