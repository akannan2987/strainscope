# StrainScope — optional secrets, one KEY=VALUE per line.
# Copy this file to `.env` (which Git ignores) and fill in real values there.
# NEVER put a real key in THIS file — .env.example is committed as a template.

# Optional: a free NCBI API key raises the Datasets rate limit from 5 to 10
# requests/second. Get one at https://www.ncbi.nlm.nih.gov/account/ (Account
# settings -> API Key Management). Leave unset and everything still works.
NCBI_API_KEY=
