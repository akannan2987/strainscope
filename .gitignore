# ===========================================================================
# StrainScope .gitignore
#
# Golden rule:
#   COMMIT the receipts (requirements.txt, renv.lock, .Rprofile,
#   strainscope.Rproj) so others can rebuild your setup.
#   IGNORE the rebuildable toolboxes, the regenerable data, and anything
#   secret or personal.
# ===========================================================================

# --- Secrets: never commit API keys or credentials (most important) ---
.streamlit/secrets.toml
.env
.env.local
.Renviron
# NOTE: .streamlit/config.toml IS committed (it holds no secrets);
#       only secrets.toml is ignored above.

# --- Python: ignore the rebuildable toolbox and caches ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
# NOTE: requirements.txt IS committed - it is the receipt that rebuilds .venv.

# --- R / renv: keep the receipts, ignore the built library ---
# COMMITTED (do NOT ignore): renv.lock, .Rprofile, strainscope.Rproj
# .Rprofile is renv's activator (one line: source("renv/activate.R"));
# it has no secrets and must travel with the repo so renv auto-activates.
# (renv also writes its own .gitignore inside renv/ automatically.)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/staging/

# --- RStudio: ignore session junk, but COMMIT strainscope.Rproj itself ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# --- Data & databases: regenerated by the pipeline, never committed ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Belt-and-suspenders: catch database files even if one ever lands elsewhere.
*.duckdb
*.sqlite
*.sqlite3
*.db
# NOTE: artifacts/ (small predictions.csv, model.pkl, etc.) ARE committed -
#       they are the outputs the app serves. Nothing under artifacts/ is ignored.

# --- Editor & OS clutter ---
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db
